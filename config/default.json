{
  "_comment": "Default thresholds for dataMedic. Copy this file and pass --config to change them; the copy used is recorded in the run's metadata.",
  "seed": 42,
  "missing_tokens": {
    "always": ["", "null", "NULL", "Null", "NaN", "nan", "#N/A", "#NA", "#VALUE!", "#DIV/0!", "#REF!", "#NULL!", "<NA>", "NaT"],
    "in_numeric_or_date_columns": ["NA", "N/A", "n/a", "na", "N.A.", "None", "none", "nil", "-", "--", "---", "?", "??", ".", "missing", "Missing", "unknown", "Unknown", "UNKNOWN", "not available", "Not Available", "not applicable", "Not Applicable", "tbd", "TBD", "n.v.", "x", "X"],
    "review_in_text_columns": ["NA", "N/A", "n/a", "na", "None", "none", "nil", "-", "--", "?", "unknown", "Unknown", "UNKNOWN", "not available", "Not Available", "not applicable", "Not Applicable", "missing", "Missing", "tbd", "TBD", "0"]
  },
  "sentinel_numbers": [-999999, -99999, -9999, -999, -99, 999, 9999, 99999, 999999, 9999999],
  "type_inference": {
    "parse_share_for_conversion": 0.95,
    "max_failed_share_to_convert": 0.05,
    "categorical_max_unique_share": 0.5,
    "categorical_max_levels": 200,
    "free_text_min_avg_length": 40,
    "identifier_min_unique_share": 0.95
  },
  "missing": {
    "leave_missing_above_share": 0.4,
    "impute_numeric_up_to_share": 0.3,
    "mode_impute_categorical_up_to_share": 0.05,
    "skew_threshold_for_median": 0.5,
    "add_indicator": true,
    "association_alpha": 0.01
  },
  "outliers": {
    "iqr_k": 1.5,
    "iqr_k_extreme": 3.0,
    "z_threshold": 3.0,
    "modified_z_threshold": 3.5,
    "min_n": 20
  },
  "categories": {
    "rare_share": 0.01,
    "fuzzy_similarity": 0.88,
    "near_constant_share": 0.99,
    "high_cardinality_levels": 50
  },
  "eda": {
    "max_numeric_columns": 30,
    "max_group_levels": 20,
    "max_tests": 200,
    "alpha": 0.05,
    "strong_correlation": 0.5,
    "collinearity_correlation": 0.85,
    "max_charts": 24,
    "scatter_sample": 5000,
    "normality_sample": 5000
  },
  "large_data": {
    "warn_file_mb": 500,
    "default_sample_rows": 200000
  },
  "_comment_imputation": "Masked-value comparison: hide a share of known values, fill them with each candidate method fitted on the rest, and compare with the truth. Evidence levels map the comparison and the amount of supporting data to a qualitative level; see references/imputation.md for the reasoning behind each number.",
  "imputation_comparison": {
    "enabled": true,
    "min_observed": 40,
    "mask_share": 0.2,
    "max_masked": 2000,
    "repeats": 3,
    "switch_if_error_lower_by": 0.1
  },
  "imputation_evidence": {
    "insufficient_below_support": 3,
    "limited_below_support": 10,
    "strong_min_support": 30,
    "good_normalised_mae": 0.5,
    "max_normalised_mae": 0.9,
    "good_accuracy": 0.8,
    "usable_accuracy": 0.5,
    "max_gap_for_strong": 1
  },
  "time_series": {
    "max_gap_steps": 3,
    "_why": "A straight line between neighbours is a fair local estimate for a few missing steps; across longer gaps it hides whatever happened there, so longer runs are left missing."
  },
  "anomalies": {
    "max_features": 12,
    "min_distinct": 20,
    "min_rows": 50,
    "contamination": "auto",
    "max_rows_listed": 200,
    "robust_distance_quantile": 0.999,
    "write_row_scores": true
  },
  "missing_dates": {
    "chronological_rho": 0.9,
    "_why": "Missing dates are placed in time by their neighbours only when an order key (file order or a numeric ID) tracks the date this closely; below it, a neighbour's date says nothing about the missing one."
  },
  "report": {
    "preview_rows": 500,
    "interactive": false,
    "redact_sensitive": true
  },
  "charts": {
    "formats": ["png"],
    "dpi": 150,
    "use_seaborn": "auto"
  }
}
